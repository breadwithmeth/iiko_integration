IIKO_BASE_URL=https://api-ru.iiko.services/api
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=

IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=

DATABASE_URL=postgresql://iiko:iiko@localhost:5432/iiko_call_center?schema=public
JWT_SECRET=change-me-at-least-32-characters

API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173

# Order status check interval in minutes (default: 5)
ORDER_STATUS_CHECK_INTERVAL_MINUTES=5

# Название корневой группы номенклатуры iiko, подгруппы которой считаются
# кухонными категориями для бонусов операторов (по умолчанию: Кухня).
# Используется, только если KITCHEN_CATEGORY_NAMES не задан.
KITCHEN_ROOT_GROUP_NAME=Кухня

# Явный список кухонных категорий через запятую (точные названия групп iiko).
# Имеет приоритет над KITCHEN_ROOT_GROUP_NAME. Пример:
# KITCHEN_CATEGORY_NAMES=Закуски, Горячие закуски, Салаты, Супы, Основные блюда, Гарниры
KITCHEN_CATEGORY_NAMES=
