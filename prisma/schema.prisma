generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum OrderStatus {
  DRAFT
  SUBMITTING
  CREATED
  FAILED
  UNKNOWN
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  orders   Order[]
  auditLogs AuditLog[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                         String   @id @default(uuid())
  iikoId                     String   @unique
  name                       String
  country                    String?
  restaurantAddress          String?
  currencyIsoName            String?
  isCloud                    Boolean?
  defaultCallCenterPaymentTypeId String?
  rawData                    Json
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  terminalGroups TerminalGroup[]
  products       Product[]
  productGroups  ProductGroup[]
  paymentTypes   PaymentType[]
  orderTypes     OrderType[]
  orders         Order[]
}

model TerminalGroup {
  id             String   @id @default(uuid())
  iikoId         String   @unique
  organizationId String
  name           String
  address        String?
  disabled       Boolean  @default(false)
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model ProductGroup {
  id             String   @id @default(uuid())
  groupId        String   @unique
  organizationId String
  name           String
  parentGroupId  String?
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id                   String   @id @default(uuid())
  productId            String   @unique
  organizationId        String?
  name                 String
  type                 String
  article              String?
  code                 String?
  description          String?
  parentGroupId        String?
  defaultSalePrice     Decimal  @db.Decimal(12, 2)
  imageUrl             String?
  productSizeId        String?
  modifierSchemaId     String?
  modifierSchemaRedefinitions Json?
  modifiers            Json?
  rawData              Json
  revision             String?
  modifiedAt           DateTime?
  deleted              Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  group        ProductGroup? @relation(fields: [parentGroupId], references: [groupId])
  orderItems   OrderItem[]

  @@index([name])
  @@index([article])
  @@index([code])
  @@index([parentGroupId])
}

model Customer {
  id        String   @id @default(uuid())
  phone     String
  firstName String?
  lastName  String?
  email     String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([phone, email])
  @@index([phone])
}

model PaymentType {
  id             String   @id @default(uuid())
  iikoId         String   @unique
  organizationId String
  name           String
  kind           String
  code           String?
  isDeleted      Boolean  @default(false)
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model OrderType {
  id             String   @id @default(uuid())
  iikoId         String   @unique
  organizationId String
  name           String
  orderServiceType String?
  isDeleted      Boolean  @default(false)
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model Order {
  id               String      @id @default(uuid())
  idempotencyKey   String?     @unique
  externalNumber   String      @unique
  iikoOrderId      String?
  iikoPosId        String?
  correlationId    String?
  organizationId   String
  terminalGroupId  String
  orderTypeId      String?
  paymentTypeId    String?
  customerId       String
  operatorId       String
  status           OrderStatus @default(DRAFT)
  iikoStatus       String?
  total            Decimal     @db.Decimal(12, 2)
  requestPayload   Json?
  responsePayload  Json?
  errorPayload     Json?
  errorMessage     String?
  submittedAt      DateTime?
  lastStatusCheckAt DateTime?
  lastStatusResponse Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  terminalGroup TerminalGroup @relation(fields: [terminalGroupId], references: [id])
  orderType     OrderType?    @relation(fields: [orderTypeId], references: [id])
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  operator      User          @relation(fields: [operatorId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  productId     String?
  iikoProductId String
  productSizeId String?
  name          String
  price         Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(10, 3)
  comment       String?
  modifiers     Json?
  createdAt     DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model IikoApiLog {
  id             String   @id @default(uuid())
  event          String
  method         String
  path           String
  httpStatus     Int?
  latencyMs      Int?
  correlationId  String?
  requestBody    Json?
  responseBody   Json?
  errorBody      Json?
  createdAt      DateTime @default(now())
}

model ApiError {
  id        String   @id @default(uuid())
  source    String
  message   String
  detail    Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
